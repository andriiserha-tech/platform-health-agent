# Copy to .env and fill in. .env is git-ignored — never commit it.
# Every variable is prefixed with HEALTH_AGENT_.

# --- Azure Data Factory (leave all three empty to skip ADF) ---
# Auth uses DefaultAzureCredential: `az login` locally, managed identity in Azure.
HEALTH_AGENT_ADF_SUBSCRIPTION_ID=
HEALTH_AGENT_ADF_RESOURCE_GROUP=
HEALTH_AGENT_ADF_FACTORY_NAME=

# --- Databricks (leave host empty to skip Databricks) ---
# Auth uses the Databricks SDK chain: token below, or Azure CLI / managed identity if omitted.
HEALTH_AGENT_DATABRICKS_HOST=
HEALTH_AGENT_DATABRICKS_TOKEN=

# --- Microsoft Teams (Workflows "post to channel when a webhook request is received") ---
HEALTH_AGENT_TEAMS_WEBHOOK_URL=

# --- Thresholds (optional, defaults shown) ---
# HEALTH_AGENT_LOOKBACK_HOURS=24
# HEALTH_AGENT_ADF_STUCK_MINUTES=120
# HEALTH_AGENT_CLUSTER_STUCK_MINUTES=20

# --- Auto-remediation (optional). Off unless --remediate is passed AND the cluster opts in. ---
# Clusters opt in with the custom tag below, or by id in the allowlist (comma-separated).
# HEALTH_AGENT_REMEDIATION_OPT_IN_TAG=auto_heal
# HEALTH_AGENT_REMEDIATION_CLUSTER_ALLOWLIST=
# HEALTH_AGENT_REMEDIATION_MAX_RESTARTS_PER_RUN=3
# HEALTH_AGENT_REMEDIATION_COOLDOWN_MINUTES=60
